# Що AI-асистенту читати незащо: згенероване, велике й не наше.
# Конфіги (package.json, svelte.config.js, tsconfig.json, eslint.config.js)
# тут СВІДОМО не перелічені — саме з них асистент розуміє профіль проєкту.
node_modules/
.svelte-kit/
build/
coverage/
package-lock.json
.git/
.env
.env.local
# Артефакти прогонів: великі, згенеровані, і жодного контексту в них немає
# (CI-CD-AND-TOOLS-v9 § 2.2 називає їх прямо). Каталоги справді з'являються тут:
# `test-results/` і `.lighthouseci/` лежать у корені після кожного прогону.
playwright-report/
test-results/
blob-report/
.lighthouseci/
# Растрові каталоги: 6 МБ, з яких асистенту нічого не видно.
static/photo/
static/png/
static/departments/
static/og/
